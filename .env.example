# Anthropic Claude APIキー（必須）
# https://console.anthropic.com/ で発行したキーを設定してください。
# このファイルをコピーして .env.local を作成し、値を入力してください。
# .env.local はコミットされません。
ANTHROPIC_API_KEY=

# 用途別モデル設定（任意・lib/ai/config.ts で一元管理）
# 通常の一括生成（POST /api/generate）。コストと品質のバランスが良いSonnet系が既定。
ANTHROPIC_GENERATION_MODEL=claude-sonnet-5
# 部分再生成（POST /api/regenerate）。既定は通常生成と同じSonnet系。
ANTHROPIC_REGENERATION_MODEL=claude-sonnet-5
# 将来の「高品質モード」用（現時点ではUIから未使用）。既定はOpus系。
ANTHROPIC_PREMIUM_MODEL=claude-opus-4-8
